<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
    launchd plist za automatsko nightly pokretanje pipeline-a u 03:00.

    Lokacija: ~/Library/LaunchAgents/tv.domovina.fetch.nightly.plist
    Install:  automatic/launchd/install.sh
    Logs:     automatic/logs/launchd.{out,err}.log  (boot/load output)
              automatic/logs/nightly_YYYY-MM-DD.log (per-run pipeline log)

    Ako je Mac u sleep-u u 03:00, launchd će job pokrenuti na sljedećem wake-u.
    (Auto-wake za job: vidi `pmset repeat wakeorpoweron MTWRFSU 02:55:00` u README.)
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>tv.domovina.fetch.nightly</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Users/ms/git/domovinatv/fetch.domovina.tv/automatic/nightly_pipeline.sh</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/ms/git/domovinatv/fetch.domovina.tv</string>

    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>3</integer>
        <key>Minute</key>
        <integer>0</integer>
    </dict>

    <key>RunAtLoad</key>
    <false/>

    <key>StandardOutPath</key>
    <string>/Users/ms/git/domovinatv/fetch.domovina.tv/automatic/logs/launchd.out.log</string>

    <key>StandardErrorPath</key>
    <string>/Users/ms/git/domovinatv/fetch.domovina.tv/automatic/logs/launchd.err.log</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>HOME</key>
        <string>/Users/ms</string>
        <key>PATH</key>
        <string>/Users/ms/.local/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/sbin</string>
        <key>LANG</key>
        <string>en_US.UTF-8</string>
    </dict>

    <!--
        ProcessType (2026-09-19): Background -> Standard.
        Background NE stiti od gasenja — on je QoS klasa koja na Apple Siliconu
        vezuje proces I SVU NJEGOVU DJECU na efficiency jezgre. Izmjereno na
        istom ffmpeg poslu: normalni QoS 27.9x realtime, `taskpolicy -b` 2.2x.
        12.7x razlike. Posljedica u logovima: KORAK 12.5 (H.264) 98 min umjesto
        ~8, KORAK 6 (pyannote) 39 min umjesto ~3. Tako je bilo od 2026-05-26.
        Standard = normalno raspodjeljivanje; jobovi ionako idu nocu.
    -->
    <key>ProcessType</key>
    <string>Standard</string>

    <!--
        Ako neka iteracija crashne, NE restart-aj odmah (sljedeća iteracija dolazi 24h kasnije).
    -->
    <key>KeepAlive</key>
    <false/>
</dict>
</plist>
