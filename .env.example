# Vertex AI Agent Builder / Discovery Engine konfiguracija
# Kopiraj u .env i popuni stvarnim vrijednostima.

# GCP projekt ID (obavezno)
GCP_PROJECT_ID=ci-main-default-project

# GCS bucket za JSONL staging (obavezno)
# Kreiraj: gcloud storage buckets create gs://BUCKET_NAME --location=europe-west1
GCS_BUCKET_NAME=domovina-rag-import

# Vertex AI Search Data Store ID (obavezno)
# Dobiješ ga u Agent Builder konzoli ili via:
#   gcloud alpha discovery-engine data-stores list --project=$GCP_PROJECT_ID --location=global
DATA_STORE_ID=domovina-podcast-datastore

# Lokacija Data Store-a (default: global)
VERTEX_LOCATION=global

# Prefix u GCS bucketu za organizaciju (default: imports)
GCS_PREFIX=imports

# Service Account auth (opcionalno — ako ne koristiš ADC)
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account-key.json
