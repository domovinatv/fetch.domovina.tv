# Vertex AI Agent Builder / Discovery Engine konfiguracija
# Kopiraj u .env i popuni stvarnim vrijednostima.

# GCP projekt ID (obavezno)
GCP_PROJECT_ID=ci-main-default-project

# GCS bucket za JSONL staging (obavezno)
# Kreiraj: gcloud storage buckets create gs://BUCKET_NAME --location=europe-west1
GCS_BUCKET_NAME=domovina-rag-import

# Vertex AI Search Data Store ID (obavezno)
# Dobiješ ga u Agent Builder konzoli ili via:
#   gcloud alpha discovery-engine data-stores list --project=$GCP_PROJECT_ID --location=global
DATA_STORE_ID=domovina-podcast-datastore

# Lokacija Data Store-a (default: global)
VERTEX_LOCATION=global

# Prefix u GCS bucketu za organizaciju (default: imports)
GCS_PREFIX=imports

# Service Account auth (opcionalno — ako ne koristiš ADC)
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account-key.json

# ─── Cloudflare R2 (cdn.domovina.ai) ─────────────────────────────
# Za upload pipeline outputa u R2 (korak 12, --with-r2-upload)
# Kreiraj API token u: https://dash.cloudflare.com → R2 → Manage R2 API Tokens

# Cloudflare Account ID (vidljiv u URL-u dashboarda)
R2_ACCOUNT_ID=7dc7167b7e2e00923bfa7cd697df14e4

# R2 API Token credentials (Object Read & Write)
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Bucket name (default: cdn-domovina-ai)
R2_BUCKET_NAME=cdn-domovina-ai

# Javni CDN URL (Cloudflare custom domain na R2 bucketu)
R2_PUBLIC_URL=https://cdn.domovina.ai

# ─── Magisterium AI (teološko obogaćivanje) ──────────────────────
# Za korak 8.5 (--with-magisterium): teološka analiza i usklađenost
# s katoličkim naukom i Svetim pismom (score 0-100 + citati).
# API ključ: https://www.magisterium.com/developers/api
MAGISTERIUM_API_KEY=
